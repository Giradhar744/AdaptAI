# ==============================================================================
# AdaptAI Backend Environment Configuration Template
# ==============================================================================

ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL / Supabase / Neon / Render)
# Example local postgres: postgresql://postgres:postgres@localhost:5432/adaptai
# Example Supabase: postgresql://postgres.<ref>:<password>@<pooler_host>:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptai
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/adaptai

# Security & Authentication (Replace in production)
JWT_SECRET=insecure-dev-secret-change-in-production-min32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI Provider Configuration (Default: zero-cost local fixtures)
LLM_PROVIDER=fake
LLM_API_KEY=fake-dev-key
LLM_MODEL=fake-default
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# Speech Providers
TTS_PROVIDER=fake
STT_PROVIDER=fake

# Video Storage Provider
VIDEO_PROVIDER=fake
LOCAL_UPLOAD_DIR=./uploads

# Pedagogical Rules
CONSENT_COOLDOWN_MINUTES=30
RATING_MIN_ATTEMPTS=5
DPP_DEFAULT_QUESTIONS=5
TEST_DEFAULT_QUESTIONS=10
TEST_DEFAULT_MINUTES=20
STRUGGLE_WINDOW_QUESTIONS=4

# Feature Flags
AGENT_DIAGNOSTIC_ENABLED=true
AGENT_ZPD_HINT_ENABLED=true
AGENT_CONTENT_GEN_ENABLED=true
AGENT_STRUGGLE_ENABLED=true
AGENT_CONSENT_ENABLED=true
AGENT_TEACHER_COPILOT_ENABLED=true
