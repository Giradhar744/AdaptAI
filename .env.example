# AdaptAI Environment Configuration Template

# Environment & Server
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adaptai
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/adaptai

# Security & Authentication
JWT_SECRET=insecure-dev-secret-change-in-production-min32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM Provider Configuration
# Supported providers: fake | nvidia | gemini | openai | groq | openrouter
LLM_PROVIDER=nvidia
LLM_API_KEY=nvapi-your-nvidia-api-key-here
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# NVIDIA NIM Specific Configuration (Free at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Speech Providers
# Supported: browser (Free Web Speech API with Indian English en-IN) | fake | elevenlabs
TTS_PROVIDER=browser
STT_PROVIDER=fake

# Video Storage Provider
# Supported: fake | local | s3
VIDEO_PROVIDER=fake
LOCAL_UPLOAD_DIR=./uploads

# Pedagogical & Adaptation Engine Rules
CONSENT_COOLDOWN_MINUTES=30
RATING_MIN_ATTEMPTS=5
DPP_DEFAULT_QUESTIONS=5
TEST_DEFAULT_QUESTIONS=10
TEST_DEFAULT_MINUTES=20
STRUGGLE_WINDOW_QUESTIONS=4

# Feature Flags for Agents and Evaluation Baselines
AGENT_DIAGNOSTIC_ENABLED=true
AGENT_ZPD_HINT_ENABLED=true
AGENT_CONTENT_GEN_ENABLED=true
AGENT_STRUGGLE_ENABLED=true
AGENT_CONSENT_ENABLED=true
AGENT_TEACHER_COPILOT_ENABLED=true
