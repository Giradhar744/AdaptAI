# ==============================================================================
# AdaptAI Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secrets (Keep .env.example only)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
backend/.env
frontend/.env
frontend/.env.*
*.pem
*.key
*.cert
*.crt
# Allow example template
!.env.example

# ------------------------------------------------------------------------------
# Agent, Internal IDE & Brain Caches (Do not commit to GitHub)
# ------------------------------------------------------------------------------
AGENT/
agent/
.agents/
.gemini/
.antigravity/
.cursor/
.windsurf/
scratch/
.system_generated/
*.log

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
ENV/
backend/venv/
backend/.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node.js & Frontend Builds
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/

# ------------------------------------------------------------------------------
# Databases, Backups & Local Uploads
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
uploads/
backend/uploads/

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
